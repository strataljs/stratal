{
  "name": "@stratal/testing",
  "version": "0.0.22",
  "description": "Testing utilities and mocks for Stratal framework applications",
  "type": "module",
  "license": "MIT",
  "author": "Stratal Contributors",
  "homepage": "https://github.com/strataljs/stratal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strataljs/stratal.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/strataljs/stratal/issues"
  },
  "keywords": [
    "stratal",
    "testing",
    "mocks",
    "cloudflare-workers",
    "vitest"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./database": {
      "types": "./dist/database/index.d.mts",
      "import": "./dist/database/index.mjs"
    },
    "./feature-flags": {
      "types": "./dist/feature-flags/index.d.mts",
      "import": "./dist/feature-flags/index.mjs"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.mts",
      "import": "./dist/mocks/index.mjs"
    },
    "./mocks/zenstack-language": {
      "types": "./dist/mocks/zenstack-language.d.mts",
      "import": "./dist/mocks/zenstack-language.mjs"
    },
    "./storage": {
      "types": "./dist/storage/index.d.mts",
      "import": "./dist/storage/index.mjs"
    },
    "./vitest-plugin": {
      "types": "./dist/vitest-plugin/index.d.mts",
      "import": "./dist/vitest-plugin/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "npx oxlint .",
    "lint:fix": "npx oxlint --fix ."
  },
  "dependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.12",
    "@golevelup/ts-vitest": "^4.0.0",
    "msw": "^2.14.6"
  },
  "peerDependencies": {
    "@stratal/framework": ">=0.0.22",
    "better-auth": ">=1.4",
    "pg": "^8.0.0",
    "stratal": ">=0.0.21",
    "vitest": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@stratal/framework": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260603.1",
    "@stratal/framework": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@vitest/runner": "~4.1.8",
    "@vitest/snapshot": "~4.1.8",
    "better-auth": "^1.6.14",
    "pg": "^8.21.0",
    "stratal": "workspace:*",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "~4.1.8"
  }
}

{
  "name": "@stratal/testing",
  "version": "0.0.27",
  "description": "Testing utilities and mocks for Stratal framework applications",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Stratal Contributors",
  "homepage": "https://github.com/strataljs/stratal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strataljs/stratal.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/strataljs/stratal/issues"
  },
  "keywords": [
    "stratal",
    "testing",
    "mocks",
    "cloudflare-workers",
    "vitest"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./database": {
      "types": "./dist/database/index.d.mts",
      "import": "./dist/database/index.mjs"
    },
    "./feature-flags": {
      "types": "./dist/feature-flags/index.d.mts",
      "import": "./dist/feature-flags/index.mjs"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.mts",
      "import": "./dist/mocks/index.mjs"
    },
    "./mocks/cloudflare-workers": {
      "types": "./dist/mocks/cloudflare-workers.d.mts",
      "import": "./dist/mocks/cloudflare-workers.mjs"
    },
    "./mocks/noop-rate-limiter-store": {
      "types": "./dist/mocks/noop-rate-limiter-store.d.mts",
      "import": "./dist/mocks/noop-rate-limiter-store.mjs"
    },
    "./mocks/zenstack-language": {
      "types": "./dist/mocks/zenstack-language.d.mts",
      "import": "./dist/mocks/zenstack-language.mjs"
    },
    "./storage": {
      "types": "./dist/storage/index.d.mts",
      "import": "./dist/storage/index.mjs"
    },
    "./vitest-plugin": {
      "types": "./dist/vitest-plugin/index.d.mts",
      "import": "./dist/vitest-plugin/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "npx oxlint .",
    "lint:fix": "npx oxlint --fix ."
  },
  "dependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "@golevelup/ts-vitest": "^4.0.0",
    "msw": "^2.15.0"
  },
  "peerDependencies": {
    "@better-auth/core": ">=1.6",
    "@stratal/framework": ">=0.0.27",
    "better-auth": ">=1.4",
    "pg": "^8.0.0",
    "stratal": ">=0.0.27",
    "vitest": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@better-auth/core": {
      "optional": true
    },
    "@stratal/framework": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@better-auth/core": "^1.6.23",
    "@cloudflare/workers-types": "5.20260716.1",
    "@stratal/framework": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@vitest/runner": "~4.1.10",
    "@vitest/snapshot": "~4.1.10",
    "better-auth": "^1.6.23",
    "pg": "^8.22.0",
    "stratal": "workspace:*",
    "tsdown": "^0.22.9",
    "typescript": "^7.0.2",
    "vitest": "~4.1.10"
  }
}

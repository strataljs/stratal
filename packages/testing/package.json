{
  "name": "@stratal/testing",
  "version": "0.0.18",
  "description": "Testing utilities and mocks for Stratal framework applications",
  "type": "module",
  "license": "MIT",
  "author": "Stratal Contributors",
  "homepage": "https://github.com/strataljs/stratal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strataljs/stratal.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/strataljs/stratal/issues"
  },
  "keywords": [
    "stratal",
    "testing",
    "mocks",
    "cloudflare-workers",
    "vitest"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.mts",
      "import": "./dist/mocks/index.mjs"
    },
    "./mocks/nodemailer": {
      "types": "./dist/mocks/nodemailer.d.mts",
      "import": "./dist/mocks/nodemailer.mjs"
    },
    "./mocks/zenstack-language": {
      "types": "./dist/mocks/zenstack-language.d.mts",
      "import": "./dist/mocks/zenstack-language.mjs"
    },
    "./storage": {
      "types": "./dist/storage/index.d.mts",
      "import": "./dist/storage/index.mjs"
    },
    "./vitest-plugin": {
      "types": "./dist/vitest-plugin/index.d.mts",
      "import": "./dist/vitest-plugin/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "npx oxlint .",
    "lint:fix": "npx oxlint --fix ."
  },
  "dependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.5",
    "@golevelup/ts-vitest": "^4.0.0",
    "msw": "^2.12.14"
  },
  "peerDependencies": {
    "@stratal/framework": "^0.0.18",
    "better-auth": "^1.4.9",
    "reflect-metadata": "^0.2.2",
    "stratal": "^0.0.18",
    "vitest": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@stratal/framework": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260329.1",
    "@stratal/framework": "workspace:*",
    "@types/node": "^25.5.0",
    "@vitest/runner": "~4.1.2",
    "@vitest/snapshot": "~4.1.2",
    "better-auth": "^1.5.6",
    "reflect-metadata": "^0.2.2",
    "stratal": "workspace:*",
    "tsdown": "^0.21.6",
    "typescript": "^6.0.2",
    "vitest": "~4.1.2"
  }
}

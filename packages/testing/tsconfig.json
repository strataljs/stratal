{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "lib": [
      "ES2024",
      "ESNext"
    ],
    "types": [
      "node",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tsdown.config.ts",
    "vitest.config.ts"
  ]
}

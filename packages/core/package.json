{
  "name": "stratal",
  "version": "0.0.25",
  "description": "A modular Cloudflare Workers framework with dependency injection, queue-based events, and type-safe configuration",
  "type": "module",
  "license": "MIT",
  "author": "Temitayo Fadojutimi",
  "homepage": "https://stratal.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strataljs/stratal.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/strataljs/stratal/issues"
  },
  "keywords": [
    "cloudflare-workers",
    "framework",
    "dependency-injection",
    "modules",
    "hono",
    "queue",
    "cron",
    "i18n",
    "openapi",
    "typescript"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "quarry": "./dist/bin/quarry.mjs",
    "stratal": "./dist/bin/quarry.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./cache": {
      "types": "./dist/cache/index.d.mts",
      "import": "./dist/cache/index.mjs"
    },
    "./config": {
      "types": "./dist/config/index.d.mts",
      "import": "./dist/config/index.mjs"
    },
    "./cron": {
      "types": "./dist/cron/index.d.mts",
      "import": "./dist/cron/index.mjs"
    },
    "./di": {
      "types": "./dist/di/index.d.mts",
      "import": "./dist/di/index.mjs"
    },
    "./email": {
      "types": "./dist/email/index.d.mts",
      "import": "./dist/email/index.mjs"
    },
    "./errors": {
      "types": "./dist/errors/index.d.mts",
      "import": "./dist/errors/index.mjs"
    },
    "./events": {
      "types": "./dist/events/index.d.mts",
      "import": "./dist/events/index.mjs"
    },
    "./guards": {
      "types": "./dist/guards/index.d.mts",
      "import": "./dist/guards/index.mjs"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.mts",
      "import": "./dist/i18n/index.mjs"
    },
    "./i18n/messages/en": {
      "types": "./dist/i18n/messages/en/index.d.mts",
      "import": "./dist/i18n/messages/en/index.mjs"
    },
    "./i18n/utils": {
      "types": "./dist/i18n/utils/index.d.mts",
      "import": "./dist/i18n/utils/index.mjs"
    },
    "./logger": {
      "types": "./dist/logger/index.d.mts",
      "import": "./dist/logger/index.mjs"
    },
    "./macroable": {
      "types": "./dist/macroable/index.d.mts",
      "import": "./dist/macroable/index.mjs"
    },
    "./module": {
      "types": "./dist/module/index.d.mts",
      "import": "./dist/module/index.mjs"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.mts",
      "import": "./dist/openapi/index.mjs"
    },
    "./quarry": {
      "types": "./dist/quarry/index.d.mts",
      "import": "./dist/quarry/index.mjs"
    },
    "./quarry/runner": {
      "types": "./dist/quarry/runner.d.mts",
      "import": "./dist/quarry/runner.mjs"
    },
    "./queue": {
      "types": "./dist/queue/index.d.mts",
      "import": "./dist/queue/index.mjs"
    },
    "./rate-limiter": {
      "types": "./dist/rate-limiter/index.d.mts",
      "import": "./dist/rate-limiter/index.mjs"
    },
    "./router": {
      "types": "./dist/router/index.d.mts",
      "import": "./dist/router/index.mjs"
    },
    "./seeder": {
      "types": "./dist/seeder/index.d.mts",
      "import": "./dist/seeder/index.mjs"
    },
    "./storage": {
      "types": "./dist/storage/index.d.mts",
      "import": "./dist/storage/index.mjs"
    },
    "./storage/providers": {
      "types": "./dist/storage/providers/index.d.mts",
      "import": "./dist/storage/providers/index.mjs"
    },
    "./websocket": {
      "types": "./dist/websocket/index.d.mts",
      "import": "./dist/websocket/index.mjs"
    },
    "./workers": {
      "types": "./dist/workers/index.d.mts",
      "import": "./dist/workers/index.mjs"
    },
    "./package.json": "./package.json",
    "./validation": {
      "types": "./dist/i18n/validation/index.d.mts",
      "import": "./dist/i18n/validation/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "yarn tsc --noEmit",
    "bench": "vitest bench --run",
    "bench:unit": "vitest bench --run --project unit",
    "bench:e2e": "vitest bench --run --project e2e",
    "bench:json": "vitest bench --run --outputJson benchmark-results.json",
    "test": "NODE_OPTIONS='--expose-gc' vitest run",
    "test:watch": "NODE_OPTIONS='--expose-gc' vitest",
    "test:integration": "NODE_OPTIONS='--expose-gc' vitest run --project workerd",
    "test:coverage": "NODE_OPTIONS='--expose-gc' vitest run --coverage",
    "lint": "npx oxlint .",
    "lint:fix": "npx oxlint --fix ."
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.40",
    "@swc/helpers": "^0.5.23",
    "clipanion": "^4.0.0-rc.4",
    "hono": "^4.12.23",
    "intl-messageformat": "^11.2.7",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@react-email/render": ">=2",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.12",
    "@cloudflare/workers-types": "4.20260603.1",
    "@react-email/render": "^2.0.8",
    "@stratal/testing": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/runner": "~4.1.8",
    "@vitest/snapshot": "~4.1.8",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "~4.1.8"
  }
}

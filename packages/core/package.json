{
  "name": "stratal",
  "version": "0.0.14",
  "description": "A modular Cloudflare Workers framework with dependency injection, queue-based events, and type-safe configuration",
  "type": "module",
  "license": "MIT",
  "author": "Temitayo Fadojutimi",
  "homepage": "https://stratal.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strataljs/stratal.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/strataljs/stratal/issues"
  },
  "keywords": [
    "cloudflare-workers",
    "framework",
    "dependency-injection",
    "modules",
    "hono",
    "queue",
    "cron",
    "i18n",
    "openapi",
    "typescript"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./cache": {
      "types": "./dist/cache/index.d.mts",
      "import": "./dist/cache/index.mjs"
    },
    "./config": {
      "types": "./dist/config/index.d.mts",
      "import": "./dist/config/index.mjs"
    },
    "./cron": {
      "types": "./dist/cron/index.d.mts",
      "import": "./dist/cron/index.mjs"
    },
    "./di": {
      "types": "./dist/di/index.d.mts",
      "import": "./dist/di/index.mjs"
    },
    "./email": {
      "types": "./dist/email/index.d.mts",
      "import": "./dist/email/index.mjs"
    },
    "./errors": {
      "types": "./dist/errors/index.d.mts",
      "import": "./dist/errors/index.mjs"
    },
    "./events": {
      "types": "./dist/events/index.d.mts",
      "import": "./dist/events/index.mjs"
    },
    "./guards": {
      "types": "./dist/guards/index.d.mts",
      "import": "./dist/guards/index.mjs"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.mts",
      "import": "./dist/i18n/index.mjs"
    },
    "./i18n/messages/en": {
      "types": "./dist/i18n/messages/en/index.d.mts",
      "import": "./dist/i18n/messages/en/index.mjs"
    },
    "./logger": {
      "types": "./dist/logger/index.d.mts",
      "import": "./dist/logger/index.mjs"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.mts",
      "import": "./dist/middleware/index.mjs"
    },
    "./module": {
      "types": "./dist/module/index.d.mts",
      "import": "./dist/module/index.mjs"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.mts",
      "import": "./dist/openapi/index.mjs"
    },
    "./queue": {
      "types": "./dist/queue/index.d.mts",
      "import": "./dist/queue/index.mjs"
    },
    "./router": {
      "types": "./dist/router/index.d.mts",
      "import": "./dist/router/index.mjs"
    },
    "./storage": {
      "types": "./dist/storage/index.d.mts",
      "import": "./dist/storage/index.mjs"
    },
    "./websocket": {
      "types": "./dist/websocket/index.d.mts",
      "import": "./dist/websocket/index.mjs"
    },
    "./workers": {
      "types": "./dist/workers/index.d.mts",
      "import": "./dist/workers/index.mjs"
    },
    "./package.json": "./package.json",
    "./validation": {
      "types": "./dist/i18n/validation/index.d.mts",
      "import": "./dist/i18n/validation/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "yarn tsc --noEmit",
    "bench": "vitest bench --run",
    "bench:unit": "vitest bench --run --project unit",
    "bench:e2e": "vitest bench --run --project e2e",
    "bench:json": "vitest bench --run --outputJson benchmark-results.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --project workerd",
    "test:coverage": "vitest run --coverage",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint --fix ."
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.2.2",
    "@intlify/core-base": "^11.3.0",
    "@intlify/message-compiler": "^11.3.0",
    "@xmldom/xmldom": "^0.8.11",
    "hono": "^4.12.8",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@react-email/components": "^1.0.0",
    "@tus/server": "^2.0.0",
    "nodemailer": ">=7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@react-email/components": {
      "optional": true
    },
    "@tus/server": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "resend": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1011.0",
    "@aws-sdk/lib-storage": "^3.1011.0",
    "@aws-sdk/s3-request-presigner": "3.1011.0",
    "@cloudflare/vitest-pool-workers": "^0.13.2",
    "@cloudflare/workers-types": "4.20260317.1",
    "@react-email/components": "^1.0.10",
    "@stratal/testing": "workspace:*",
    "@tus/server": "^2.3.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/runner": "~4.1.0",
    "@vitest/snapshot": "~4.1.0",
    "nodemailer": "^8.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.9.4",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "vitest": "~4.1.0"
  }
}

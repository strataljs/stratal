{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "outDir": "./dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "stratal": [
        "./src/index.ts"
      ],
      "stratal/di": [
        "./src/di/index.ts"
      ],
      "stratal/quarry": [
        "./src/quarry/index.ts"
      ]
    },
    "lib": [
      "ES2024",
      "ESNext"
    ],
    "types": [
      "@cloudflare/workers-types",
      "node"
    ]
  },
  "include": [
    "**/*",
    "test/**/*",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tsdown.config.ts"
  ]
}

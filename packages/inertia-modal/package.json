{
  "name": "@stratal/inertia-modal",
  "version": "0.0.1",
  "description": "Modal page primitive for Stratal Inertia — backend-driven modal dialogs",
  "type": "module",
  "license": "MIT",
  "author": "Temitayo Fadojutimi",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@inertiajs/core": "^3.0.0-beta.5",
    "@inertiajs/react": "^3.0.0-beta.5",
    "@stratal/inertia": ">=0.0.18",
    "hono": "^4.12.8",
    "react": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "stratal": "^0.0.18"
  },
  "peerDependenciesMeta": {
    "@inertiajs/core": {
      "optional": true
    },
    "@inertiajs/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260412.1",
    "@inertiajs/core": "^3.0.3",
    "@inertiajs/react": "^3.0.3",
    "@stratal/inertia": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "hono": "^4.12.14",
    "react": "^19.2.5",
    "reflect-metadata": "^0.2.2",
    "stratal": "workspace:*",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2"
  }
}

{
  "name": "@stratal/framework",
  "version": "0.0.19",
  "type": "module",
  "license": "MIT",
  "author": "Temitayo Fadojutimi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strataljs/stratal.git",
    "directory": "packages/framework"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./access-control": {
      "types": "./dist/access-control/index.d.mts",
      "import": "./dist/access-control/index.mjs"
    },
    "./auth": {
      "types": "./dist/auth/index.d.mts",
      "import": "./dist/auth/index.mjs"
    },
    "./context": {
      "types": "./dist/context/index.d.mts",
      "import": "./dist/context/index.mjs"
    },
    "./database": {
      "types": "./dist/database/index.d.mts",
      "import": "./dist/database/index.mjs"
    },
    "./factory": {
      "types": "./dist/factory/index.d.mts",
      "import": "./dist/factory/index.mjs"
    },
    "./guards": {
      "types": "./dist/guards/index.d.mts",
      "import": "./dist/guards/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "generate": "zenstack generate --schema=test/schema.zmodel -o test/zenstack",
    "generate:types": "wrangler types -c test/wrangler.jsonc",
    "pretest": "npx dotenv -- yarn generate && yarn generate:types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --coverage",
    "test:db": "docker compose -f test/docker-compose.yml up -d",
    "typecheck": "yarn tsc --noEmit",
    "lint": "npx oxlint .",
    "lint:fix": "npx oxlint --fix ."
  },
  "dependencies": {
    "@better-auth/core": "^1.6.9",
    "@faker-js/faker": "^10.4.0",
    "@zenstackhq/cli": "^3.6.4",
    "@zenstackhq/orm": "^3.6.4",
    "better-auth": "^1.6.9",
    "better-call": "1.3.5",
    "postgres-array": "^3.0.4"
  },
  "peerDependencies": {
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "stratal": "^0.0.19"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.2",
    "@cloudflare/workers-types": "4.20260503.1",
    "@stratal/testing": "workspace:^",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-istanbul": "~4.1.5",
    "@vitest/runner": "~4.1.5",
    "@vitest/snapshot": "~4.1.5",
    "@zenstackhq/better-auth": "^3.6.4",
    "dotenv-cli": "^11.0.0",
    "kysely": "0.28.17",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "stratal": "workspace:*",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "~4.1.5",
    "wrangler": "^4.87.0"
  }
}

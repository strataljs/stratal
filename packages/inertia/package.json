{
  "name": "@stratal/inertia",
  "version": "0.0.22",
  "description": "Inertia.js v3 server adapter for Stratal framework — server-driven React SPAs",
  "type": "module",
  "license": "MIT",
  "author": "Temitayo Fadojutimi",
  "homepage": "https://github.com/strataljs/stratal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strataljs/stratal.git",
    "directory": "packages/inertia"
  },
  "bugs": {
    "url": "https://github.com/strataljs/stratal/issues"
  },
  "keywords": [
    "stratal",
    "inertia",
    "inertiajs",
    "react",
    "ssr",
    "cloudflare-workers",
    "server-driven-spa"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "global.d.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./quarry": {
      "types": "./dist/quarry.d.mts",
      "import": "./dist/quarry.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs"
    },
    "./seo-runtime": {
      "types": "./dist/seo-runtime.d.mts",
      "import": "./dist/seo-runtime.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npx oxlint .",
    "lint:fix": "npx oxlint --fix ."
  },
  "dependencies": {
    "intl-messageformat": "^11.2.7",
    "ts-morph": "^28.0.0"
  },
  "peerDependencies": {
    "@cloudflare/vite-plugin": ">=1.0.0",
    "@inertiajs/core": ">=3",
    "@inertiajs/react": ">=3",
    "@inertiajs/vite": ">=3",
    "@stratal/testing": ">=0.0.22",
    "hono": ">=4",
    "react": ">=19",
    "react-dom": ">=19",
    "stratal": ">=0.0.22",
    "vite": ">=8",
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "@cloudflare/vite-plugin": {
      "optional": true
    },
    "@inertiajs/core": {
      "optional": true
    },
    "@inertiajs/react": {
      "optional": true
    },
    "@inertiajs/vite": {
      "optional": true
    },
    "@stratal/testing": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.0",
    "@cloudflare/workers-types": "4.20260529.1",
    "@inertiajs/core": "^3.1.1",
    "@inertiajs/react": "^3.1.1",
    "@inertiajs/vite": "^3.1.1",
    "@stratal/testing": "workspace:*",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/runner": "~4.1.5",
    "@vitest/snapshot": "~4.1.5",
    "hono": "^4.12.18",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "stratal": "workspace:*",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "~4.1.5"
  }
}

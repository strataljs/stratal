{
  "name": "@stratal/inertia",
  "version": "0.1.0",
  "description": "Inertia.js v3 server adapter for Stratal framework — server-driven React SPAs",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Temitayo Fadojutimi",
    "url": "https://x.com/adesege_"
  },
  "homepage": "https://stratal.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strataljs/stratal.git",
    "directory": "packages/inertia"
  },
  "bugs": {
    "url": "https://github.com/strataljs/stratal/issues"
  },
  "keywords": [
    "stratal",
    "inertia",
    "inertiajs",
    "react",
    "ssr",
    "cloudflare-workers",
    "server-driven-spa"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "global.d.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./quarry": {
      "types": "./dist/quarry.d.mts",
      "import": "./dist/quarry.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs"
    },
    "./react/access": {
      "types": "./dist/react/access.d.mts",
      "import": "./dist/react/access.mjs"
    },
    "./seo-runtime": {
      "types": "./dist/seo-runtime.d.mts",
      "import": "./dist/seo-runtime.mjs"
    },
    "./services/ssr-exclusion": {
      "types": "./dist/services/ssr-exclusion.d.mts",
      "import": "./dist/services/ssr-exclusion.mjs"
    },
    "./ssr": {
      "types": "./dist/ssr.d.mts",
      "import": "./dist/ssr.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npx oxlint .",
    "lint:fix": "npx oxlint --fix ."
  },
  "dependencies": {
    "intl-messageformat": "^12.1.1",
    "ts-morph": "^28.0.0"
  },
  "peerDependencies": {
    "@cloudflare/vite-plugin": ">=1.0.0",
    "@inertiajs/core": ">=3",
    "@inertiajs/react": ">=3",
    "@inertiajs/vite": ">=3",
    "@stratal/testing": ">=0.1.0",
    "hono": ">=4",
    "react": ">=19",
    "react-dom": ">=19",
    "stratal": ">=0.1.0",
    "vite": ">=8",
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "@cloudflare/vite-plugin": {
      "optional": true
    },
    "@inertiajs/core": {
      "optional": true
    },
    "@inertiajs/react": {
      "optional": true
    },
    "@inertiajs/vite": {
      "optional": true
    },
    "@stratal/testing": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "5.20260919.1",
    "@inertiajs/core": "^3.7.1",
    "@inertiajs/react": "^3.7.1",
    "@inertiajs/vite": "^3.7.1",
    "@stratal/testing": "workspace:*",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/runner": "~4.1.11",
    "@vitest/snapshot": "~5.0.1",
    "hono": "^4.13.8",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stratal": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "~5.0.1"
  }
}

{
  "name": "@stratal/feature-flags",
  "version": "0.1.1",
  "description": "Cloudflare Flagship feature flags for the Stratal framework — binding API wrapper with Inertia.js sharing",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Temitayo Fadojutimi",
    "url": "https://x.com/adesege_"
  },
  "homepage": "https://stratal.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strataljs/stratal.git",
    "directory": "packages/feature-flags"
  },
  "bugs": {
    "url": "https://github.com/strataljs/stratal/issues"
  },
  "keywords": [
    "stratal",
    "feature-flags",
    "flagship",
    "cloudflare-workers",
    "inertia",
    "react"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npx oxlint .",
    "lint:fix": "npx oxlint --fix ."
  },
  "peerDependencies": {
    "@inertiajs/core": ">=3",
    "@inertiajs/react": ">=3",
    "@stratal/inertia": ">=0.1.1",
    "hono": ">=4",
    "react": ">=19",
    "react-dom": ">=19",
    "stratal": ">=0.1.1"
  },
  "peerDependenciesMeta": {
    "@inertiajs/core": {
      "optional": true
    },
    "@inertiajs/react": {
      "optional": true
    },
    "@stratal/inertia": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@inertiajs/core": "^3.9.1",
    "@inertiajs/react": "^3.9.1",
    "@stratal/inertia": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stratal": "workspace:*",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "~4.1.12"
  }
}

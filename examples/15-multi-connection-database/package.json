{
  "name": "stratal-example-15-multi-connection-database",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "generate:main": "zenstack generate --schema db/main/schema.zmodel -o db/main",
    "generate:analytics": "zenstack generate --schema db/analytics/schema.zmodel -o db/analytics",
    "generate": "npm run generate:main && npm run generate:analytics",
    "wrangler:types": "wrangler types",
    "db:up": "docker compose up -d",
    "db:push:main": "dotenv -- npx zenstack db push --schema db/main/schema.zmodel",
    "db:push:analytics": "dotenv -- npx zenstack db push --schema db/analytics/schema.zmodel"
  },
  "dependencies": {
    "@stratal/framework": "^0.0.15",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "stratal": "^0.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.77.0"
  }
}

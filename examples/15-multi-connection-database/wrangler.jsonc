{
  "name": "stratal-example-15-multi-connection-database",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "development"
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "placeholder"
    }
  ],
  "hyperdrive": [
    {
      "binding": "DB_MAIN",
      "id": "placeholder-main",
      "localConnectionString": "postgres://stratal:stratal@localhost:6432/stratal_main"
    },
    {
      "binding": "DB_ANALYTICS",
      "id": "placeholder-analytics",
      "localConnectionString": "postgres://stratal:stratal@localhost:7432/stratal_analytics"
    }
  ]
}

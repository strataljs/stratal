datasource db {
    provider = 'postgresql'
    url      = env('DATABASE_URL_ANALYTICS')
}

model PageView {
    id        String   @id @default(cuid())
    path      String
    userId    String?
    createdAt DateTime @default(now())
}

model Event {
    id        String   @id @default(cuid())
    name      String
    payload   String?
    userId    String?
    createdAt DateTime @default(now())
}

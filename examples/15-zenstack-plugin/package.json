{
  "name": "stratal-example-15-zenstack-plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "generate": "zenstack generate --schema db/schema.zmodel -o db/zenstack",
    "wrangler:types": "wrangler types",
    "db:up": "docker compose up -d",
    "db:push:main": "MAIN_DATABASE_URL='postgres://stratal:stratal@localhost:6432/stratal_main' npx stratal-db push --connection main --schema db/schema.zmodel",
    "db:push:analytics": "ANALYTICS_DATABASE_URL='postgres://stratal:stratal@localhost:7432/stratal_analytics' npx stratal-db push --connection analytics --schema db/schema.zmodel",
    "db:push:all": "npm run db:push:main && npm run db:push:analytics"
  },
  "dependencies": {
    "@stratal/framework": "file:../../packages/framework",
    "@stratal/zenstack-plugin": "file:../../packages/zenstack-plugin",
    "@zenstackhq/cli": "^3.4.5",
    "@zenstackhq/orm": "^3.4.4",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "stratal": "file:../../packages/core"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260306.1",
    "@types/pg": "^8.11.11",
    "typescript": "^5.9.3",
    "wrangler": "^4.71.0"
  }
}

datasource db {
    provider = 'postgresql'
    url      = env('DATABASE_URL')
}

plugin stratal {
    provider = '@stratal/zenstack-plugin'
    output   = './zenstack'
    default  = 'main'
}

// ─── Main Connection ────────────────────────────────────────────────

model User {
    id        String   @id @default(cuid())
    email     String   @unique
    name      String
    posts     Post[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@connection("main")
}

model Post {
    id        String   @id @default(cuid())
    title     String
    content   String?
    published Boolean  @default(false)
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@connection("main")
}

// ─── Analytics Connection ───────────────────────────────────────────

model PageView {
    id        String   @id @default(cuid())
    path      String
    userId    String?
    createdAt DateTime @default(now())

    @@connection("analytics")
}

model Event {
    id        String   @id @default(cuid())
    name      String
    payload   String?
    userId    String?
    createdAt DateTime @default(now())

    @@connection("analytics")
}

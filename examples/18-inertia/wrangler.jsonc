{
  "name": "stratal-example-18-inertia",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development"
  },
  // Replace "placeholder" with actual KV namespace IDs from `wrangler kv namespace create`
  "kv_namespaces": [
    { "binding": "CACHE", "id": "placeholder" },
    { "binding": "NOTES", "id": "placeholder" }
  ]
}

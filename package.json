{
  "name": "stratal-monorepo",
  "packageManager": "yarn@4.17.1",
  "private": true,
  "description": "A modular Cloudflare Workers framework with dependency injection, queue-based events, and type-safe configuration",
  "license": "MIT",
  "author": {
    "name": "Temitayo Fadojutimi",
    "url": "https://x.com/adesege_"
  },
  "homepage": "https://stratal.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strataljs/stratal.git"
  },
  "bugs": {
    "url": "https://github.com/strataljs/stratal/issues"
  },
  "keywords": [
    "cloudflare-workers",
    "framework",
    "dependency-injection",
    "modules",
    "hono",
    "queue",
    "cron",
    "i18n",
    "openapi",
    "typescript"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "changeset": "changeset",
    "release": "changeset publish",
    "typecheck": "yarn workspaces foreach -At --no-private run typecheck",
    "version-packages": "changeset version && yarn install --no-immutable",
    "build": "yarn workspaces foreach -At --no-private run build",
    "test": "yarn workspaces foreach -At --no-private run test",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "lint-staged": {
    "*.{ts,mts}": [
      "oxlint --fix"
    ]
  },
  "resolutions": {
    "@paralleldrive/cuid2": "^3.3.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "3.0.3",
    "@opentelemetry/api": "^1.9.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2"
  }
}
